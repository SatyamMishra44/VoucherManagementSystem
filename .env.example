# ============================================================
# Voucher Management System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ============================================================

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://mysql:3306/new_voucher_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password
MYSQL_ROOT_PASSWORD=your_secure_db_password

# --- JWT Authentication ---
JWT_SECRET=your_64_character_hex_secret_key_here_generate_with_openssl_rand

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Email / SMTP (required for PDF report delivery) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_AUTH=true
SMTP_STARTTLS=true
REPORT_EMAIL_FROM=your-email@gmail.com
